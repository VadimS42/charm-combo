; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to a script
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Charm Combo"
config/description="A match-3 romance for adults, set in Duskhaven, a twilight town where fantastical folk make their home. Meet four women in the worst way possible, help them with what they need, and see where the night goes."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="CharmCombo"
boot_splash/bg_color=Color(0.984314, 0.960784, 0.945098, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://autoload/GameState.gd"
SFX="*res://autoload/SFX.gd"
Music="*res://autoload/Music.gd"
Nav="*res://autoload/Nav.gd"
Achievements="*res://autoload/Achievements.gd"
Platform="*res://autoload/Platform.gd"
Voice="*res://autoload/Voice.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=5

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[internationalization]

locale/translations=PackedStringArray("res://translations/ru.po", "res://translations/zh_CN.po")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
