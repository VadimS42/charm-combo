msgstr "Пропускати непрочитане"

msgid "Skip any chapter, carry on after any loss, and 8 hearts instead of 5."
msgstr "Пропускай будь-який розділ, продовжуй після будь-якого програшу, і 8 сердець замість 5."

msgid "Skip chapter"
msgstr "Пропустити розділ"

msgid "Skip chapter  ▸"
msgstr "Пропустити розділ  ▸"

