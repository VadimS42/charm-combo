msgstr "%s: pilih sebuah permata."

msgid "(You need %d more stars.)"
msgstr "(Kamu butuh %d bintang lagi.)"

msgid "+%d moves"
msgstr "+%d langkah"

msgid "+%d pts — great answer!"
msgstr "+%d poin — jawaban bagus!"

msgid "+%d to win her over"
msgstr "+%d untuk memikatnya"

