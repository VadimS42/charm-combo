msgid "\"Don't even think about it.\""
msgstr "«Ni se te ocurra.»"

msgid "\"I was fine. It was quiet in there.\""
msgstr "«Estaba bien. Ahí dentro había silencio.»"

msgid "\"I was floating. On my back.\""
msgstr "«Estaba flotando. Boca arriba.»"

msgid "\"You summoned me with that pathetic chalk circle?\""
msgstr "«¿Me has invocado con ese patético círculo de tiza?»"

msgid "%d / %d endings found"
msgstr "%d / %d finales encontrados"

msgid "%d / %d pts"
msgstr "%d / %d ptos."

