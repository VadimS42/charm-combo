msgid "Original characters · all characters are adults."
msgstr "মৌলিক চরিত্র · সব চরিত্র প্রাপ্তবয়স্ক।"

msgid "Ouch!"
msgstr "উফ!"

msgid "Out in the Storm"
msgstr "ঝড়ের মধ্যে"

msgid "Out of Moves"
msgstr "চাল শেষ"

msgid "Out of hearts"
msgstr "হৃদয় শেষ"

msgid "Out of moves"
msgstr "চাল শেষ"

msgid "Owned"
msgstr "আপনার আছে"

