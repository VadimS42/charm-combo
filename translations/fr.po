msgid "\"Don't even think about it.\""
msgstr "« N'y pense même pas. »"

msgid "\"I was fine. It was quiet in there.\""
msgstr "« J'allais bien. C'était calme, là-dedans. »"

msgid "\"I was floating. On my back.\""
msgstr "« Je flottais. Sur le dos. »"

msgid "\"You summoned me with that pathetic chalk circle?\""
msgstr "« Tu m'as invoquée avec ce pitoyable cercle à la craie ? »"

msgid "%d / %d endings found"
msgstr "%d / %d fins trouvées"

msgid "%d / %d pts"
msgstr "%d / %d pts"

msgid "%d / %d unlocked"
msgstr "%d / %d débloqués"

msgid "%d pts"
msgstr "%d pts"

msgid "%d pts — rough start..."
msgstr "%d pts — début difficile..."

msgid "%d pts..."
msgstr "%d pts..."

msgid "%s is ready!"
msgstr "%s : c'est prêt !"

msgid "%s: pick a gem."
msgstr "%s : choisis une gemme."

msgid "(You need %d more stars.)"
msgstr "(Il te manque %d étoiles.)"

msgid "+%d moves"
msgstr "+%d coups"

msgid "+%d pts — great answer!"
msgstr "+%d pts — belle réponse !"

msgid "+%d to win her over"
msgstr "+%d pour la séduire"

