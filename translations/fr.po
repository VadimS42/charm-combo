msgstr "+%d ⭐ pour l'effort"

msgid "+%d ⭐ towards it"
msgstr "+%d ⭐ pour t'aider"

msgid "+1 heart"
msgstr "+1 cœur"

msgid "+2 moves — great answer!"
msgstr "+2 coups — belle réponse !"

