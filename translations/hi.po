msgstr "अध्याय का लक्ष्य"

msgid "COMB PIECES"
msgstr "कंघी के टुकड़े"

msgid "COMING UP"
msgstr "आगे आने वाला"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Carry on without clearing this chapter (no stars for it)."
msgstr "यह अध्याय पूरा किए बिना आगे बढ़ें (इसके सितारे नहीं मिलेंगे)।"

msgid "Chain Reaction"
msgstr "शृंखला प्रतिक्रिया"

msgid "Chapter %d / %d"
msgstr "अध्याय %d / %d"

