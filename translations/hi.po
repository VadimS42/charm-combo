msgstr "अध्याय पर वापस"

msgid "Back to the roster"
msgstr "मंडली पर वापस"

msgid "Balanced route"
msgstr "संतुलित रास्ता"

msgid "Best chapter score"
msgstr "अध्याय का सबसे अच्छा स्कोर"

msgid "Best combo"
msgstr "सबसे अच्छा कॉम्बो"

msgid "Best daily challenge"
msgstr "सबसे अच्छी दैनिक चुनौती"

